# ─── Supabase ───────────────────────────────────────────────────────────────
# Found in: Supabase Dashboard → Project Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here   # Server-only. Never expose to browser.

# ─── OpenAI ──────────────────────────────────────────────────────────────────
# Found in: https://platform.openai.com/api-keys
# Used for caption-based AI summaries (GPT-3.5-turbo, ~$0.002 per video)
# Optional: if omitted, summaries will fall back to raw caption text.
OPENAI_API_KEY=sk-your-openai-key-here

# ─── Admin & Cron secrets ────────────────────────────────────────────────────
# ADMIN_SECRET: protects the POST /api/sync endpoint.
#   Set to any long random string, e.g.: openssl rand -hex 32
# CRON_SECRET:  Vercel Cron uses this when calling GET /api/cron.
#   Set to the SAME value as ADMIN_SECRET (or a separate secret).
ADMIN_SECRET=your-random-admin-secret-here
CRON_SECRET=your-random-cron-secret-here

# ─── TikTok (Phase 2 — not needed for Phase 1) ──────────────────────────────
# Once your TikTok developer app is approved and you complete OAuth,
# paste the access token here. Leave blank for Phase 1 (seed data used).
TIKTOK_ACCESS_TOKEN=
